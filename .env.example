# HelpMePay Server Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_dev_change_in_production_123456789
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Razorpay / Payment Gateway (Optional - falls back to built-in QR simulator if unprovided)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
